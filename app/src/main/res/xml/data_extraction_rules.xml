<?xml version="1.0" encoding="utf-8"?>
<!--
  Kopia zapasowa (Android 12+): ustawienia (DataStore: klasa, grupy, motyw, powiadomienia)
  oraz ulubione ogłoszenia (files/favorite_announcements.json) są przywracane na nowym telefonie.
  Baza Room zawiera podręczną kopię danych ze strony szkoły + stan
  synchronizacji — wykluczona, żeby po przywróceniu nie było starych danych, a pierwszy sync
  zbudował stan od nowa (bez lawiny powiadomień).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="last_crash.txt" />
        <exclude domain="file" path="datastore/calendar_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="last_crash.txt" />
        <exclude domain="file" path="datastore/calendar_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
