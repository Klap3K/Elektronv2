<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Automatyczne wyciszanie telefonu w trakcie trwania lekcji (Auto DND) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Przypomnienia przed lekcją o czasie (Android 12+: użytkownik może odmówić -
         wtedy alarm niedokładny, kilka minut opóźnienia). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Po restarcie telefonu ponowne ustawienie przypomnienia o lekcji (Android kasuje alarmy). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Wykrywanie zainstalowanej oficjalnej aplikacji eduVULCAN / Dzienniczek VULCAN na urządzeniu -->
    <queries>
        <package android:name="pl.edu.vulcan.hebece" />
        <package android:name="pl.edu.vulcan.uonetmobile" />
        <package android:name="pl.vulcan.uonetmobile" />
    </queries>

    <application
        android:name=".ElektronApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Elektron"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".ElektronActivity"
            android:launchMode="singleTop"
            android:exported="true"
            android:theme="@style/Theme.Elektron"
            android:windowSoftInputMode="adjustResize" />

        <!-- Ikony aplikacji do wyboru w Ustawieniach (AppIcons): dokładnie jeden wpis launchera jest
             włączony. Domyślny nosi dawną nazwę .MainActivity - ikona dodana na ekran główny przed
             aktualizacją zostaje. Skróty (AppShortcuts) są dynamiczne, przypięte do włączonego wpisu. -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".ElektronActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconLight"
            android:targetActivity=".ElektronActivity"
            android:icon="@mipmap/ic_launcher_light"
            android:roundIcon="@mipmap/ic_launcher_light"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Wycofana ikona "bez tła" z wersji testowych: tylko po to, by aplikacja z nią wybraną nie
             straciła ikony przy aktualizacji (AppIcons.migrate przełącza na domyślną). -->
        <activity-alias
            android:name=".IconClear"
            android:targetActivity=".ElektronActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".widget.NextLessonWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_next_lesson_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_lesson_info" />
        </receiver>

        <receiver
            android:name=".widget.DayPlanWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_day_plan_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_day_plan_info" />
        </receiver>

        <receiver
            android:name=".widget.SubstitutionsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_substitutions_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_substitutions_info" />
        </receiver>

        <!-- Restart, aktualizacja aplikacji, zmiana czasu/strefy: przypomnienie i widżety od nowa.
             exported - te komunikaty wysyła tylko system (chronione akcje). -->
        <receiver
            android:name=".work.SystemEventsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Alarm przypomnienia przed lekcją (tylko z własnego PendingIntent). -->
        <receiver
            android:name=".work.LessonReminderReceiver"
            android:exported="false" />
        <!-- Alarm przypomnienia o notatce (tylko z własnego PendingIntent). -->
        <receiver
            android:name=".work.NoteReminderReceiver"
            android:exported="false" />

        <!-- Automatyczne wyciszanie telefonu na lekcjach (Auto DND) -->
        <receiver
            android:name=".service.AutoDndReceiver"
            android:exported="false" />

        <!-- Kafelek w szybkich ustawieniach: najbliższa lekcja. -->
        <service
            android:name=".widget.NextLessonTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_elektron"
            android:label="@string/tile_next_lesson"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!-- Mostek powiadomień z zainstalowanej aplikacji eduVULCAN na urządzeniu -->
        <service
            android:name=".service.EduVulcanNotificationListener"
            android:exported="true"
            android:label="Synchronizacja z aplikacji eduVULCAN"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
