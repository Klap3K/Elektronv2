# --- Gradle / Android Studio ---
.gradle/
.kotlin/
build/
/captures
.externalNativeBuild
.cxx
*.iml
/.idea/
local.properties

# --- Gotowe paczki (trafiają do GitHub Releases, nie do repo) ---
*.apk
*.aab
*.idsig
/app/release/
/app/gms/
/app/github/

# --- Podpis release: klucz i hasła nigdy nie trafiają do repozytorium ---
keystore.properties
*.jks
*.keystore
*.pfx
*.pfx.b64

# --- Konfiguracja Firebase: trzymana lokalnie (kopia zapasowa poza repo) ---
# Świeży klon potrzebuje własnego pliku - patrz README / PORADNIK_PUSH.md.
app/google-services.json

# --- Pliki lokalne ---
AI_CONTEXT.md
update*.sh
fix_*.sh
/scripts/
/build_elektron.sh
/*.txt
/.agents/
/.codex/
/.aws/
.env
.env.*
!.env.example

# --- Robocze dokumenty pozostają lokalnie ---
# W docs publiczne są grafiki; dokumenty użytkownika są w katalogu głównym.
/docs/**/*.md
/reports/
/audits/
/iterations/
/local-notes/
*REPORT*.md
*report*.md
*RAPORT*.md
*raport*.md
*AUDIT*.md
*audit*.md
*AUDYT*.md
*audyt*.md
*_PLAN.md
*_plan.md
*-iter*.md
*_iter*.md

# Tylko końcowe opisy wersji; pozostałą zawartość sprawdza kontrola repozytorium.
/release-notes/*-files.sha256
/release-notes/*-iter*
/release-notes/*_iter*
*.bak
*.orig
*.rej

# --- Zrzuty i raporty awarii JVM (mogą mieć setki MB) ---
hs_err_pid*.log
replay_pid*.log
core.[0-9]*
*.hprof

# --- System ---
.DS_Store
.directory
Thumbs.db
*~

# Opisy wydań F-Droid są częścią repozytorium.
!fastlane/metadata/android/**/*.txt

# Licencja biblioteki mapy dołączona do aplikacji.
!app/src/main/assets/licenses/osmdroid.txt
